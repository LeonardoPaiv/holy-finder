# ---- Database (server-only) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# ---- Supabase (auth + storage) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Server-only. NEVER prefix with NEXT_PUBLIC_ — bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
NEXT_PUBLIC_BUCKET_NAME=<storage-bucket-name>

# ---- Captcha ----
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=<hcaptcha-site-key>

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Image moderation (server-only) ----
MODERATION_PROVIDER=sightengine
SIGHTENGINE_API_USER=<api-user>
SIGHTENGINE_API_SECRET=<api-secret>

# ---- Google AdSense (public by design) ----
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-<id>
NEXT_PUBLIC_GOOGLE_AD_SLOT=auto

# ---- Feature flags ----
NEXT_PUBLIC_ENABLE_DONATIONS=false
NEXT_PUBLIC_ENABLE_ADS=false
